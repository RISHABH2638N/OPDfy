# Only these folders and files are allowed at the repository root.
/*
!/.gitignore
!/README.md
!/DEPLOYMENT.md
!/client/
!/scripts/
!/server/

# Dependencies
node_modules/

# Environment secrets (safe example templates remain allowed)
.env
.env.*
!.env.example
!.env.*.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# Build output and caches
dist/
build/
.vite/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# Test output and temporary files (keep source tests and reviewed fixtures)
coverage/
.nyc_output/
qa-results/
playwright-report/
test-results/
tmp/
temp/
*.tmp

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime uploads, patient documents, and private storage
uploads/
/server/storage/
/server/private/
patient-documents/

# Database backups and exports
backups/
*.archive
*.archive.gz
*.archive.gz.enc
*.bson
*.dump
*.sqlite
*.sqlite3
*.manifest.json

# Deployment platform local files
.vercel/
.render/

# Editors and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Archives
*.zip
*.rar
*.7z
*.tar
*.tar.gz
