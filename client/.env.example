# Frontend environment configuration
# For local development these defaults point to the local backend.
# For LAN/mobile testing, replace localhost with your computer's LAN IP.
# For production, use the deployed HTTPS backend URL.

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Optional development fallback clinic.
# For a production multi-clinic deployment, leave blank. Production requires explicit clinic selection.
VITE_CLINIC_SLUG=demo-clinic
