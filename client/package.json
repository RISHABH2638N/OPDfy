{
  "name": "opd-smart-queue-client",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:privacy": "node --experimental-vm-modules --test test/apiSessionRouting.test.mjs test/clinicalConsentRouting.test.mjs test/followUpNotificationText.test.mjs test/localization.test.mjs test/patientAuthRouting.test.mjs test/privacyPhase3Routing.test.mjs test/privacyRouting.test.mjs",
    "test": "node --experimental-vm-modules --test test/*.test.mjs && npm run test:ssr",
    "test:browser": "node test/browser/verify.mjs",
    "test:ssr": "node scripts/test-public-ssr.mjs",
    "test:e2e": "node test/browser/release.mjs",
    "test:visual:update": "node test/browser/updateSnapshots.mjs",
    "test:seo": "node test/browser/seo.mjs",
    "test:landing": "node test/browser/landing.mjs",
    "test:patient-ux": "node test/browser/patientUx.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "8.0.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
