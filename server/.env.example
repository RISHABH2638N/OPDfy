PORT=5000
MONGO_URI=
JWT_SECRET=
QR_JWT_SECRET=
DISPLAY_KEY_ENCRYPTION_SECRET=
CLIENT_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
OTP_FROM_NAME=OPDfy

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HOSPITAL_TIMEZONE=Asia/Kolkata
APPOINTMENT_SLOT_MINUTES=15
ETA_RECENT_SAMPLE_SIZE=10
DEFAULT_CONSULTATION_MINUTES=7

# SaaS tenant bootstrap (development only). MUST be blank in production.
DEFAULT_TENANT_SLUG=demo-clinic
DEFAULT_TENANT_NAME=Demo Clinic

# SaaS platform owner console (use a different secret from clinic staff JWT)
SUPER_ADMIN_JWT_SECRET=
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=

# Same-day online reservation cap per doctor. Remaining OPD capacity stays available for walk-ins.
ONLINE_RESERVATION_LIMIT_PER_DOCTOR=70

# Day 9 operational audit retention. MongoDB TTL removes old activity metadata automatically.
AUDIT_LOG_RETENTION_DAYS=90

# Day 12 production hardening
# Development defaults are intentionally friendlier; production defaults remain strict.
NODE_ENV=development
LOGIN_RATE_WINDOW_MINUTES=15
# Optional overrides (defaults: dev 100/IP + 20/account; production 30/IP + 5/account)
# LOGIN_RATE_IP_MAX=30
# LOGIN_RATE_EMAIL_MAX=5
# API_RATE_MAX_PER_MINUTE=300

# Optional MongoDB timeout tuning. Defaults below are safe for Atlas/network hiccups.
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Day 20 security hardening
# Production secrets above must each be >=32 random characters and distinct.
DISPLAY_KEY_TTL_DAYS=90
AI_RATE_MAX_PER_MINUTE=12
QR_RATE_MAX_PER_MINUTE=30
# In production, external logo URLs are rejected unless the host is listed here.
# Prefer uploaded data-image logos. Example: cdn.example.com,assets.example.com
CLINIC_ASSET_ALLOWED_HOSTS=
# Security events are metadata-only; do not put secrets/clinical text in them.
# Production rate-limit counters are shared through the configured MongoDB database.

# Exact trusted reverse-proxy hop count; 0 for direct local access.
# Set to match your hosting topology; do not blindly trust arbitrary proxies.
TRUST_PROXY_HOPS=0

# Optional development seed; both required by npm run seed.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=


# DPDP Privacy Phase 2: keep disabled until a qualified legal/clinical review,
# clinic retention approvals, database backup and staging acceptance are complete.
PRIVACY_ERASURE_ENABLED=false
PRIVACY_RETENTION_POLICY_VERSION=

# Real incident-response alerts. Messages contain incident metadata only.
SECURITY_ALERT_EMAIL=security@example.com
# Per-staff patient-data requests in ten minutes before a high-severity alert.
INCIDENT_PATIENT_ACCESS_THRESHOLD=80

# Encrypted Backup & Disaster Recovery. Keep disabled until external storage,
# MongoDB Database Tools and a disposable restore deployment are configured.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_HOUR_UTC=20
BACKUP_DATABASE_NAME=opd_system
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
BACKUP_STORAGE_PROVIDER=s3
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
# Used only when BACKUP_STORAGE_PROVIDER=local; local storage is rejected in production.
BACKUP_STORAGE_DIR=
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_DAYS=28
BACKUP_RETENTION_MONTHLY_DAYS=365
# Safe default: metadata expiresAt is calculated, but remote deletion remains off.
BACKUP_RETENTION_DELETE_ENABLED=false
# Must point to a separate/disposable MongoDB deployment for restore drills.
PRIVACY_RESTORE_URI=
PRIVACY_RESTORE_ALLOW_SAME_DEPLOYMENT=false
MONGODUMP_BIN=mongodump
MONGORESTORE_BIN=mongorestore
